# 复制成 .env 再填。.env 已在 .gitignore 里，绝不提交。
# 四个值都在桌面《账号密码总表》的 4.5 / 4.6 两节里。

# 卖货口：中心站给我的 mgw_ 凭证（4.6）
MGW_KEY=

# 进货口：GOLEM 沙盘控制台账号（4.5）
GOLEM_EMAIL=
GOLEM_PASSWORD=

# 面板 Basic 认证口令（自己定）
PANEL_USER=zbk
PANEL_PASSWORD=

# 进货口：三把上游 key 的明文。GOLEM 只在创建时回显一次，丢了取不回来，
# 而守护循环必须拿它探活 —— 所以随 Secret 一起播种（4.5 节）。
GOLEM_KEY_GPT_POOL=
GOLEM_KEY_DEEPSEEK_RELAY=
GOLEM_KEY_CCMAX_KEY=

# 可选，都有默认值
# JANUS_BASE=https://gate.oaiai.ai
# GOLEM_BASE=https://fake.oaiai.ai
# DB_PATH=/data/pushkey.db
# PROBE_SECONDS=60
# HEARTBEAT_SECONDS=300
