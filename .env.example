# 复制成 .env 再填。.env 已在 .gitignore 里，绝不提交。
# 四个值都在桌面《账号密码总表》的 4.5 / 4.6 两节里。

# 卖货口：中心站给我的 mgw_ 凭证（4.6）
MGW_KEY=

# 进货口：GOLEM 沙盘控制台账号（4.5）
GOLEM_EMAIL=
GOLEM_PASSWORD=

# 面板 Basic 认证口令（自己定）
PANEL_USER=zbk
PANEL_PASSWORD=

# 可选，都有默认值
